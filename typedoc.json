
{
  "readme": "README.md",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/core"
  ],
  "packageOptions": {
    "entryPoints": [
      "src/**/index.ts"
    ],
    "entryPointStrategy": "resolve"
  },
  "out": "./docs/api",
  "docsRoot": "./docs",
  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme"
  ],
  "sidebar": {
    "autoConfiguration": true,
    "format": "vitepress",
    "collapsed": true,
    "pretty": true
  },
  "excludeExternals": false
}
